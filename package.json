{
  "name": "lumen-ambient",
  "version": "1.0.0",
  "description": "Open-source ambient rim lighting, liquid-glass now playing card, and real-time kinetic synchronized lyrics for Spotify, Apple Music & local tracks.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "concurrently \"npm run server\" \"npm run dev\""
  },
  "keywords": [
    "lumen",
    "lumn",
    "verci",
    "ambient-lighting",
    "synced-lyrics",
    "lrclib",
    "spotify",
    "apple-music",
    "liquid-glass",
    "macos"
  ],
  "author": "Lumen Community",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
